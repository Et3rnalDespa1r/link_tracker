{
  "uid": "linktracker",
  "title": "LinkTracker",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "custom",
        "query": "bot,scrapper",
        "multi": true,
        "includeAll": true,
        "allValue": "bot|scrapper",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RAM, bytes",
      "description": "RAM, bytes over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"$app\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API requests/s",
      "description": "API requests/s over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(api_requests_total{job=~\"$app\"}[5m])) by (source)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tracked links",
      "description": "Tracked links over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(links_on_track_total{job=~\"$app\"}) by (tracked_source)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bot commands/s",
      "description": "Bot commands/s over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(command_requests_total{job=~\"$app\"}[5m])) by (command)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Notifications/s",
      "description": "Notifications/s over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sent_notification_total{job=~\"$app\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape latency p50",
      "description": "Scrape latency p50 over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(request_duration_ms_total_bucket{job=~\"$app\"}[5m])) by (le, scope, scope_type))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Scrape latency p95",
      "description": "Scrape latency p95 over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(request_duration_ms_total_bucket{job=~\"$app\"}[5m])) by (le, scope, scope_type))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Scrape latency p99",
      "description": "Scrape latency p99 over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(request_duration_ms_total_bucket{job=~\"$app\"}[5m])) by (le, scope, scope_type))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bot command latency p50",
      "description": "Bot command latency p50 over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(command_duration_ms_total_bucket{job=~\"$app\"}[5m])) by (le, scope, scope_type))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Bot command latency p95",
      "description": "Bot command latency p95 over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(command_duration_ms_total_bucket{job=~\"$app\"}[5m])) by (le, scope, scope_type))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Bot command latency p99",
      "description": "Bot command latency p99 over time; app filter selects bot/scrapper.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(command_duration_ms_total_bucket{job=~\"$app\"}[5m])) by (le, scope, scope_type))"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP errors/s",
      "description": "HTTP errors/s",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(linktracker_http_requests_total{job=~\"$app\",status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "HTTP p95 latency, seconds",
      "description": "HTTP p95 latency, seconds",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(linktracker_http_duration_seconds_bucket{job=~\"$app\"}[5m])) by (le))"
        }
      ]
    }
  ]
}
